{
  "name": "smart-quiz-e2e",
  "version": "1.0.0",
  "private": true,
  "description": "E2E tests for Smart Quiz Flutter web app using Playwright",
  "scripts": {
    "test": "npx playwright test",
    "test:headed": "npx playwright test --headed",
    "test:student": "npx playwright test tests/01-student-flow.spec.ts",
    "test:teacher": "npx playwright test tests/02-teacher-flow.spec.ts",
    "test:admin": "npx playwright test tests/03-admin-flow.spec.ts",
    "test:report": "npx playwright show-report",
    "test:debug": "npx playwright test --debug"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "dotenv": "^16.4.7"
  }
}
